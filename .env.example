# 브라우저에 공개되어도 되는 Kakao Maps JavaScript 키
NEXT_PUBLIC_KAKAO_MAP_JAVASCRIPT_KEY=

# 서버에서만 사용하는 키 (NEXT_PUBLIC_ 접두사를 붙이지 마세요)
KAKAO_REST_API_KEY=
TMAP_APP_KEY=
# 선택: 보행자 경로안내 상품이 다른 앱에 연결되어 있으면 해당 appKey
# 비어 있으면 TMAP_APP_KEY를 사용합니다.
TMAP_WALK_APP_KEY=

# auto: 실제 API 시도 후 실패하면 Demo Mode
# live: 실제 API만 사용하고 실패를 그대로 반환
# demo: 항상 Mock/Demo 데이터 사용
ROUTE_DATA_MODE=live

# Demo Mode에서 이 시간이 지나면 교통체증 시나리오로 전환
DEMO_CONGESTION_AFTER_SECONDS=30

# 선택: 대체 배경 지도 제공자. 변경 후 다시 빌드하세요.
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
# ROUTE_DATA_MODE는 장소 검색을 demo로 제한하지 않습니다.

# 선택: 실제 도착 정보. TMAP/카카오 키와 별개입니다.
# 서울시 지하철 실시간 도착정보 인증키 (서울시 지원 구간의 1~9호선)
SEOUL_SUBWAY_API_KEY=
# 공공데이터포털 서울특별시 정류소정보조회 서비스 일반(Decoding) 인증키
SEOUL_BUS_API_KEY=
